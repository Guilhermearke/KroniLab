{
  "expo": {
    "name": "KroniLab",
    "slug": "kronilab",
    "scheme": "kronilab",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "plugins": ["expo-router", "expo-sqlite", "expo-av"],
    "ios": {
      "bundleIdentifier": "app.kronilab.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "UIBackgroundModes": ["audio"],
        "UIRequiresPersistentWiFi": false
      }
    },
    "android": {
      "package": "app.kronilab.mobile",
      "permissions": ["FOREGROUND_SERVICE", "WAKE_LOCK"]
    }
  }
}
