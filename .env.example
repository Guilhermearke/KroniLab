# =============================================================================
# KroniLab — variaveis de ambiente
#
# Copie para .env e preencha. O .env esta no .gitignore: nenhuma chave entra
# no repositorio.
#
# Depois de preencher, rode:  npm run doctor
# =============================================================================

# --- Supabase (banco, auth, realtime) ----------------------------------------
# Painel do projeto -> Settings -> API
# A anon key e publica por natureza (vai dentro do app); quem protege os dados
# e o RLS da migration 0001, nao o segredo da chave.
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Usada SO pelo worker, no servidor. Ela ignora o RLS — nunca coloque no app.
SUPABASE_SERVICE_KEY=

# Token de acesso pessoal, para o MCP do Supabase e a CLI.
# Painel -> Account -> Access Tokens
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# --- Worker de audio (a IA que monta a VS) -----------------------------------
EXPO_PUBLIC_WORKER_URL=http://localhost:8000

# mock  = sem GPU, copia o audio em cada stem (desenvolvimento)
# demucs = GPU propria
# replicate = API externa
KRONILAB_SEPARATION_PROVIDER=mock

# --- Cloudflare R2 (os arquivos grandes: stems, click, guia) ------------------
# Painel -> R2 -> Manage API tokens
KRONILAB_R2_ENDPOINT=
KRONILAB_R2_BUCKET=kronilab
KRONILAB_R2_ACCESS_KEY=
KRONILAB_R2_SECRET_KEY=

# --- Cloudflare (conta, para o MCP e o Pages) --------------------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# --- Fila ---------------------------------------------------------------------
KRONILAB_REDIS_URL=redis://localhost:6379/0
