{
  "name": "kronilab",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma integrada de ministerio de louvor: igreja, cultos, escalas, repertorio, IA de VS, estudo, offline e live playback.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspace @kronilab/core",
    "mobile": "npm run start --workspace @kronilab/mobile",
    "build": "npm run build --workspace @kronilab/web-demo",
    "demo": "npm run dev --workspace @kronilab/web-demo",
    "doctor": "node scripts/doctor.mjs"
  }
}
